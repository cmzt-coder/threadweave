{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadweave.local/schemas/state.schema.json",
  "title": "Threadweave Run State",
  "description": "One Threadweave run in machine-readable form. The Markdown leader-state template remains the human-readable view; this schema is the structured source for validation, recovery and audit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "createdAt",
    "updatedAt",
    "status",
    "project",
    "integration",
    "authorization",
    "limits",
    "leader",
    "workers",
    "resources",
    "mergeOrder",
    "integrationLog",
    "finalReview",
    "cleanup",
    "errors"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "preflight",
        "initializing",
        "dispatching",
        "observing",
        "integrating",
        "final-review",
        "complete",
        "failed",
        "aborted",
        "cleanup_pending"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "hostId",
        "canonicalRepositoryRoot",
        "commonDirectory"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "hostId": {
          "type": "string",
          "minLength": 1
        },
        "canonicalRepositoryRoot": {
          "type": "string",
          "minLength": 1
        },
        "commonDirectory": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseSha",
        "branch",
        "repoPath"
      ],
      "properties": {
        "baseSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "repoPath": {
          "type": "string",
          "minLength": 1
        },
        "currentSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance",
        "messagingScope"
      ],
      "properties": {
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "messagingScope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workers",
        "initializationTimeoutSeconds",
        "replacementPerRole"
      ],
      "properties": {
        "workers": {
          "type": "integer",
          "minimum": 1
        },
        "initializationTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "replacementPerRole": {
          "type": "integer",
          "minimum": 0
        },
        "maxReworkPerWorker": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "leader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threadId"
      ],
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "attempt",
          "state",
          "branch",
          "baseSha",
          "createdAt",
          "deadline",
          "lastObservation",
          "errors"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "planned",
              "creating",
              "pending",
              "validating",
              "ready",
              "dispatched",
              "running",
              "blocked",
              "reported",
              "integrated",
              "archived",
              "failed",
              "cancelled"
            ]
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "baseSha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "threadId": {
            "type": [
              "string",
              "null"
            ]
          },
          "creationIdentifiers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "clientThreadId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "operationId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pendingWorktreeId": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "worktree": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          },
          "lastObservation": {
            "type": "string",
            "format": "date-time"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "message",
                "at"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "provider",
                    "host_api",
                    "supervisor_process",
                    "workspace_setup",
                    "model_output",
                    "acceptance",
                    "worker_process",
                    "unknown"
                  ]
                },
                "stage": {
                  "type": "string",
                  "minLength": 1
                },
                "resultCertainty": {
                  "type": "string",
                  "enum": [
                    "confirmed_failure",
                    "unknown"
                  ]
                },
                "retryable": {
                  "type": "boolean"
                },
                "recommendation": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                },
                "retryEvidence": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "resolved": {
                  "type": "boolean"
                }
              }
            }
          },
          "dispatchAt": {
            "type": "string",
            "format": "date-time"
          },
          "dispatchIntent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dispatchId",
              "message",
              "at",
              "result"
            ],
            "properties": {
              "dispatchId": {
                "type": "string",
                "minLength": 1
              },
              "bridgeOperationId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "message": {
                "type": "string"
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "result": {
                "type": "string",
                "enum": [
                  "pending",
                  "sent",
                  "unknown",
                  "acknowledged",
                  "not_sent"
                ]
              },
              "resolvedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "startupEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "attempt",
              "cwd",
              "worktree_root",
              "git_common_dir",
              "branch",
              "head",
              "status_porcelain",
              "validatedAt"
            ],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "cwd": {
                "type": "string",
                "minLength": 1
              },
              "worktree_root": {
                "type": "string",
                "minLength": 1
              },
              "git_common_dir": {
                "type": "string",
                "minLength": 1
              },
              "branch": {
                "type": "string",
                "minLength": 1
              },
              "head": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "status_porcelain": {
                "type": "string"
              },
              "validatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "stopStatus": {
            "type": "string",
            "enum": [
              "requested",
              "confirmed"
            ]
          },
          "stopRequestedAt": {
            "type": "string",
            "format": "date-time"
          },
          "stopConfirmedAt": {
            "type": "string",
            "format": "date-time"
          },
          "reworkCount": {
            "type": "integer",
            "minimum": 0
          },
          "reworkNotes": {
            "type": "string"
          },
          "activityRevision": {
            "type": "integer",
            "minimum": 0
          },
          "stopActivityRevision": {
            "type": "integer",
            "minimum": 0
          },
          "lastProgressAt": {
            "type": "string",
            "format": "date-time"
          },
          "statusRequestedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastCheckedAt": {
            "type": "string",
            "format": "date-time"
          },
          "graceDeadline": {
            "type": "string",
            "format": "date-time"
          },
          "branchTip": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "report": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "threadId",
              "branch",
              "head",
              "reportSha",
              "taskRevision",
              "baseIsAncestor",
              "acceptedAt"
            ],
            "properties": {
              "threadId": {
                "type": "string",
                "minLength": 1
              },
              "branch": {
                "type": "string",
                "minLength": 1
              },
              "head": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "reportSha": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "taskRevision": {
                "type": "integer",
                "minimum": 0
              },
              "baseIsAncestor": {
                "type": "boolean"
              },
              "acceptedAt": {
                "type": "string",
                "format": "date-time"
              },
              "runId": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "commitSha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "filesChanged": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "testsRun": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "contractChanges": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "knownRisks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "selfReportedVerification": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "ownedPaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scopeExceptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result",
              "reportSha",
              "worktree"
            ],
            "properties": {
              "result": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "context",
                  "planHash",
                  "steps",
                  "startedAt",
                  "finishedAt"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "passed",
                      "failed"
                    ]
                  },
                  "context": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "runId",
                      "role",
                      "attempt",
                      "taskRevision",
                      "stage",
                      "head"
                    ],
                    "properties": {
                      "runId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "role": {
                        "type": "string",
                        "minLength": 1
                      },
                      "attempt": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "taskRevision": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "stage": {
                        "enum": [
                          "worker",
                          "integration"
                        ]
                      },
                      "head": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}$"
                      }
                    }
                  },
                  "planHash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "startedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "finishedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "error": {
                    "type": "string"
                  }
                }
              },
              "reportSha": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "worktree": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "verificationPlan": {
            "type": "object"
          },
          "hostObservation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runId",
              "role",
              "attempt",
              "taskRevision",
              "operationId",
              "source",
              "observedAt",
              "requestSha",
              "responseSha",
              "toolResultSha",
              "metadata"
            ],
            "properties": {
              "runId": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "taskRevision": {
                "type": "integer",
                "minimum": 0
              },
              "operationId": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "const": "desktop_tool_bridge"
              },
              "observedAt": {
                "type": "string",
                "format": "date-time"
              },
              "requestSha": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "responseSha": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "toolResultSha": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "metadata": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "threadId",
                  "hostId",
                  "status"
                ],
                "properties": {
                  "threadId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hostId": {
                    "const": "local"
                  },
                  "status": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "recoveryPreservation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "oldAttempt",
              "threadId",
              "threadAbsenceConfirmed",
              "threadAbsenceEvidence",
              "branch",
              "head",
              "worktree",
              "worktreeExists",
              "statusPorcelain",
              "unmergedCommits",
              "branchPreserved",
              "reportPresent",
              "reportArchived",
              "notesPresent",
              "notesArchived",
              "dirtyPatchArchived",
              "dirtyPatchSha256",
              "preservedAt",
              "preservationSha"
            ],
            "properties": {
              "oldAttempt": {
                "type": "integer",
                "minimum": 1
              },
              "threadId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "threadAbsenceConfirmed": {
                "const": true
              },
              "threadAbsenceEvidence": {
                "type": "string",
                "minLength": 1
              },
              "branch": {
                "type": "string",
                "minLength": 1
              },
              "head": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "worktree": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "worktreeExists": {
                "type": "boolean"
              },
              "statusPorcelain": {
                "type": "string"
              },
              "unmergedCommits": {
                "type": "boolean"
              },
              "branchPreserved": {
                "const": true
              },
              "reportPresent": {
                "type": "boolean"
              },
              "reportArchived": {
                "type": "boolean"
              },
              "notesPresent": {
                "type": "boolean"
              },
              "notesArchived": {
                "type": "boolean"
              },
              "dirtyPatchArchived": {
                "type": "boolean"
              },
              "dirtyPatchSha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              },
              "preservedAt": {
                "type": "string",
                "format": "date-time"
              },
              "preservationSha": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "recoveryReplacementAuthorization": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "preservationSha",
              "nextAttempt",
              "limit",
              "authorizedAt"
            ],
            "properties": {
              "preservationSha": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "nextAttempt": {
                "type": "integer",
                "minimum": 2
              },
              "limit": {
                "type": "integer",
                "minimum": 0
              },
              "authorizedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id",
          "owner",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "worktree",
              "report",
              "notes",
              "branch",
              "automation"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "preserved",
              "removed",
              "archived",
              "pending"
            ]
          }
        }
      }
    },
    "mergeOrder": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "integrationLog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "branch",
          "result",
          "verification"
        ],
        "properties": {
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "mergeCommit": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "type": "string",
            "enum": [
              "pending",
              "merged",
              "failed",
              "skipped"
            ]
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "beforeSha": {
            "type": [
              "string",
              "null"
            ]
          },
          "afterSha": {
            "type": [
              "string",
              "null"
            ]
          },
          "acceptance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "context",
              "planHash",
              "steps",
              "startedAt",
              "finishedAt"
            ],
            "properties": {
              "status": {
                "enum": [
                  "passed",
                  "failed"
                ]
              },
              "context": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "runId",
                  "role",
                  "attempt",
                  "taskRevision",
                  "stage",
                  "head"
                ],
                "properties": {
                  "runId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1
                  },
                  "attempt": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "taskRevision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "stage": {
                    "enum": [
                      "worker",
                      "integration"
                    ]
                  },
                  "head": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                }
              },
              "planHash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "startedAt": {
                "type": "string",
                "format": "date-time"
              },
              "finishedAt": {
                "type": "string",
                "format": "date-time"
              },
              "error": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "finalReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "notes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "complete",
            "failed",
            "aborted",
            "cleanup_pending"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "preservedReports",
        "outstandingResources",
        "notes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "complete",
            "partial",
            "failed"
